MYSQL_DATABASE=roady
MYSQL_USER=roady
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/roady?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=roady
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

MQTT_ENABLED=true
MQTT_BROKER_IP=localhost
MQTT_BROKER_PORT=1883

ROADY_ROBOT_LOCATION_REDIS_KEY_PATTERN=roady:robots:{robotId}:location
ROADY_ROBOT_LOCATION_TTL=5m

ROADY_AI_IMAGE_ANALYSIS_ENDPOINT_URL=http://localhost:8000/analyze
ROADY_AI_IMAGE_ANALYSIS_WORKER_ENABLED=false
ROADY_AI_IMAGE_ANALYSIS_BATCH_SIZE=3
ROADY_AI_IMAGE_ANALYSIS_POLL_DELAY_MS=1000
ROADY_AI_IMAGE_ANALYSIS_REQUEST_TIMEOUT=3m

ROADY_KAKAO_GEOCODING_ENABLED=false
ROADY_KAKAO_REST_API_KEY=change-me
ROADY_KAKAO_COORD2_ADDRESS_URL=https://dapi.kakao.com/v2/local/geo/coord2address.json
ROADY_KAKAO_GEOCODING_REQUEST_TIMEOUT=3s

# Comma-separated Vue development and deployed origins.
ROADY_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-vue-domain.example
